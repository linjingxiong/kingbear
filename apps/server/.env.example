PORT=3000
MONGO_URI=mongodb://localhost:27017/kingbear

JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# 单用户模式：首次启动如果 users 集合是空的，会自动用这组账号密码建管理员
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-in-production

# OCR_PROVIDER: stub（占位，不识别）| qwen-vl（通义千问VL，阿里云 DashScope）
OCR_PROVIDER=stub
# 阿里云 DashScope 的 API Key（https://dashscope.console.aliyun.com/apiKey），OCR_PROVIDER=qwen-vl 时必填
OCR_API_KEY=
# 通义千问 VL 模型名：qwen-vl-plus（性价比高，默认）| qwen-vl-max（更准，更贵）
OCR_MODEL=qwen-vl-plus

UPLOAD_DIR=uploads
