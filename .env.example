# docker-compose 用的环境变量，复制为 .env 后按需修改
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-in-production

# stub（占位，不识别）| qwen-vl（通义千问VL，阿里云 DashScope）
OCR_PROVIDER=stub
# https://dashscope.console.aliyun.com/apiKey ，OCR_PROVIDER=qwen-vl 时必填
OCR_API_KEY=
OCR_MODEL=qwen-vl-plus
