# docker-compose 用的环境变量，复制为 .env 后按需修改
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-in-production

# stub（占位，不识别）| qwen-vl（通义千问VL，阿里云 DashScope）| zhipu-vl（智谱 GLM-4V，
# 智谱 AI 开放平台，glm-4v-flash 长期免费）
OCR_PROVIDER=stub
# qwen-vl 去 https://dashscope.console.aliyun.com/apiKey 申请；
# zhipu-vl 去 https://open.bigmodel.cn 申请，OCR_PROVIDER 对应选了哪个就必填哪个的 key
OCR_API_KEY=
# qwen-vl 填 qwen-vl-plus/qwen-vl-max；zhipu-vl 填 glm-4v-flash（免费）/glm-4v-plus（收费，更准）
OCR_MODEL=qwen-vl-plus
